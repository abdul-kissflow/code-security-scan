PORT=4000

# Postgres - local dev via `brew services start postgresql@16` or
# `docker compose up -d postgres` (docker-compose.yml at repo root), then
# `npm run migrate`.
DATABASE_URL=postgres://fe_scanner:fe_scanner@localhost:5432/fe_scanner

# Session cookie signing secret (required - the server refuses to start without it).
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# SonarQube
SONAR_URL=https://sonar.example.com

# Every upload is analyzed under this existing project.
SONAR_PROJECT_KEY=your_project_key

# Used to READ results (measures/issues/hotspots) after analysis.
SONAR_TOKEN=

# Used ONLY to EXECUTE sonar-scanner against SONAR_PROJECT_KEY.
SONAR_ANALYSIS_TOKEN=

# Path to the betterleaks binary (defaults to "betterleaks" on PATH)
BETTERLEAKS_BIN=betterleaks

# Path to the sonar-scanner CLI binary (defaults to "sonar-scanner" on PATH)
SONAR_SCANNER_BIN=sonar-scanner

# Claude Agent SDK (issue explain/group/fix stage) - via Google Vertex AI.
# Auth is via `gcloud auth application-default login` - no API key needed.
CLAUDE_CODE_USE_VERTEX=1
CLOUD_ML_REGION=global
ANTHROPIC_VERTEX_PROJECT_ID=
CLAUDE_EXPLAIN_MODEL=claude-opus-5
CLAUDE_EXPLAIN_MAX_BUDGET_USD=3
CLAUDE_EXPLAIN_BATCH_SIZE=8
CLAUDE_EXPLAIN_CONCURRENCY=5
CLAUDE_EXPLAIN_MAX_TURNS_PER_BATCH=14
